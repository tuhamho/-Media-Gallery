# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin authentication (never commit real values)
ADMIN_USERNAME=
# Format: scrypt$<salt hex>$<64-byte hash hex>. Generate with:
# node scripts/hash-admin-password.js
ADMIN_PASSWORD_HASH=
# Generate a random session signing key locally:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
